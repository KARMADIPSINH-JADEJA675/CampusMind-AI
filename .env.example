# CampusMind AI - Environment Configuration
# Set DEMO_MODE=true to run completely standalone without OpenAI or MongoDB credentials
DEMO_MODE=true

# OpenAI API Key (Optional in DEMO_MODE)
OPENAI_API_KEY=

# MongoDB URI (Optional: If empty or unreachable, in-memory JSON fallback is used)
MONGODB_URI=mongodb://localhost:27017/campusmind_ai

# Security & JWT Token Secret
JWT_SECRET=campusmind-super-secret-key-genai-2026-mcp-demo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server URLs
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001/sse
